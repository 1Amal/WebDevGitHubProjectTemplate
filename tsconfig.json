{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "resolveJsonModule": true,
    "noEmit": true,

    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    "skipLibCheck": true
  },
  "include": ["src", "tests"]
}
