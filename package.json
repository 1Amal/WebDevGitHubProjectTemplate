{
  "name": "web-development-template",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable starter template for web development projects, experiments, prototypes, and learning.",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "scripts": {
    "dev": "serve src",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint": "latest",
    "prettier": "latest",
    "serve": "^14.2.6",
    "vitest": "latest"
  }
}
